{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "crons": [
    {
      "path": "/api/blog?action=auto-generate",
      "schedule": "0 14 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?ikonicmarketing303\\.com"
        }
      ],
      "destination": "https://ikonic303.com/:path*",
      "permanent": true
    },
    {
      "source": "/paint-protection-film",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/paint-protection-film.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services/paint-protection-film",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ceramic-coating",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ceramic-coating.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services/ceramic-coating",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/commercial-wraps",
      "destination": "/storefront-graphics",
      "permanent": true
    },
    {
      "source": "/commercial-wraps.html",
      "destination": "/storefront-graphics",
      "permanent": true
    },
    {
      "source": "/wrap-calculator",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services/web-design",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/services/crm-automation",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/services/reputation",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/services/speed-to-lead",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/services/marketing",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/marketing",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/marketing.html",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/print-ship",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/lost-call-calculator",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/sticker-builder",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/ai-website-generator",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/branded-to-win",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services/window-tint",
      "destination": "/window-tint",
      "permanent": true
    },
    {
      "source": "/window-tint.html",
      "destination": "/window-tint",
      "permanent": true
    },
    {
      "source": "/storefront-graphics.html",
      "destination": "/storefront-graphics",
      "permanent": true
    },
    {
      "source": "/window-tint/office.html",
      "destination": "/window-tint/office",
      "permanent": true
    },
    {
      "source": "/window-tint/storefront.html",
      "destination": "/window-tint/storefront",
      "permanent": true
    },
    {
      "source": "/window-tint/security-film.html",
      "destination": "/window-tint/security-film",
      "permanent": true
    },
    {
      "source": "/window-tint/decorative-privacy.html",
      "destination": "/window-tint/decorative-privacy",
      "permanent": true
    },
    {
      "source": "/window-tint/home",
      "destination": "/window-tint",
      "permanent": true
    },
    {
      "source": "/window-tint/home.html",
      "destination": "/window-tint",
      "permanent": true
    },
    {
      "source": "/signage",
      "destination": "/window-tint",
      "permanent": true
    },
    {
      "source": "/signage.html",
      "destination": "/window-tint",
      "permanent": true
    },
    {
      "source": "/wayfinding",
      "destination": "/window-tint",
      "permanent": true
    },
    {
      "source": "/wayfinding.html",
      "destination": "/window-tint",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/blog-posts",
      "destination": "/api/blog?action=list"
    },
    {
      "source": "/api/blog-post",
      "destination": "/api/blog?action=post"
    },
    {
      "source": "/api/publish-blog",
      "destination": "/api/blog?action=publish"
    },
    {
      "source": "/api/auto-blog-generate",
      "destination": "/api/blog?action=auto-generate"
    },
    {
      "source": "/service-areas/wheat-ridge",
      "destination": "/service-areas/wheat-ridge.html"
    },
    {
      "source": "/service-areas/arvada",
      "destination": "/service-areas/arvada.html"
    },
    {
      "source": "/service-areas/lakewood",
      "destination": "/service-areas/lakewood.html"
    },
    {
      "source": "/service-areas/golden",
      "destination": "/service-areas/golden.html"
    },
    {
      "source": "/post/:slug",
      "destination": "/404.html"
    },
    {
      "source": "/proof-manager",
      "destination": "/index.html"
    },
    {
      "source": "/proof/:token",
      "destination": "/index.html"
    },
    {
      "source": "/viral-bot",
      "destination": "/index.html"
    },
    {
      "source": "/viral-bot/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|@vite|@react-refresh|src/|node_modules/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/404.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://connect.facebook.net https://widgets.leadconnectorhq.com https://crm.ikonic303.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://www.facebook.com https://widgets.leadconnectorhq.com https://services.leadconnectorhq.com https://crm.ikonic303.com; frame-src https://crm.ikonic303.com https://widgets.leadconnectorhq.com https://www.facebook.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://crm.ikonic303.com; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
